# 美的仓储自动化桌面助手配置文件模版
# 复制本文件为 .env 并填写您的实际配置即可

# QQ 邮箱配置（用于下载物料情况邮件及附件）
QQ_EMAIL=your_email@qq.com
QQ_AUTH_CODE=your_qq_imap_auth_code

# 邮件附件与报表存储目录（支持绝对路径或相对路径，程序会自动按 YYYYMM 如 202610 建子文件夹归档）
SAVE_DIR=./downloads

# GitHub Actions 每日流水线配置
GITHUB_REPO=huozao/meidi-auto
GITHUB_WORKFLOW=run-daily.yml
GITHUB_REF=main
# 个人访问令牌（需具备 repo / workflow 权限，支持 Classic Token 以 ghp_ 开头）
GITHUB_TOKEN=ghp_your_github_token_here
